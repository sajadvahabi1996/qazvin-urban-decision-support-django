# The local startup scripts generate a secure development key automatically.
# Do not commit your real .env file.
DJANGO_SECRET_KEY=replace-this-with-a-generated-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: comma-separated HTTPS origins, e.g. https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production-only settings (review before deployment).
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=0
